 {
  "id": "C-08-query-encoding",
  "doc": "RFC 3986 + conventions: search arrives intact",
  "client": {
   "api_key": "nova_key_abc"
  },
  "call": {
   "op": "templates.list",
   "search": "PLACEHOLDER"
  },
  "server": [
   {
    "status": 200,
    "json": {
     "success": true,
     "message": "ok",
     "data": {
      "success": true,
      "pagination": {
       "count": 0,
       "next": null,
       "previous": null,
       "page": 1,
       "total_pages": 1,
       "page_size": 2
      },
      "results": []
     },
     "meta": {
      "correlation_id": "cid-p"
     }
    }
   }
  ],
  "expect": {
   "requests": [
    {
     "method": "GET",
     "path": "/api/v1/templates/",
     "query_has": {
      "search": "PLACEHOLDER"
     }
    }
   ],
   "outcome": {
    "kind": "ok"
   }
  },
  "variants": [
   {
    "call.search": "plain",
    "expect.requests.0.query_has.search": "plain"
   },
   {
    "call.search": "a&b=c",
    "expect.requests.0.query_has.search": "a&b=c"
   },
   {
    "call.search": "x y",
    "expect.requests.0.query_has.search": "x y"
   },
   {
    "call.search": "1+1=2",
    "expect.requests.0.query_has.search": "1+1=2"
   },
   {
    "call.search": "100%",
    "expect.requests.0.query_has.search": "100%"
   },
   {
    "call.search": "%20",
    "expect.requests.0.query_has.search": "%20"
   },
   {
    "call.search": "é☃😀",
    "expect.requests.0.query_has.search": "é☃😀"
   },
   {
    "call.search": "a/b?c#d",
    "expect.requests.0.query_has.search": "a/b?c#d"
   },
   {
    "call.search": "semi;colon",
    "expect.requests.0.query_has.search": "semi;colon"
   },
   {
    "call.search": "quote\"'<>",
    "expect.requests.0.query_has.search": "quote\"'<>"
   }
  ]
 },
 {
  "id": "C-09-get-retried-on-503",
  "doc": "error-handling: idempotent GET retried on 503",
