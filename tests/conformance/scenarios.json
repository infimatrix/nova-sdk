 {
  "id": "C-07a-hostile-path-id",
  "doc": "conventions: Path ids validated and URL-encoded (no extra segment, query or dot-segment)",
  "client": {
   "api_key": "nova_key_abc"
  },
  "call": {
   "op": "templates.get",
   "id": "PLACEHOLDER"
  },
  "server": [
   {
    "status": 200,
    "json": {
     "success": true,
     "message": "ok",
     "data": {
      "id": "t-1",
      "name": "Welcome"
     },
     "meta": {
      "correlation_id": "cid-1"
     }
    }
   }
  ],
  "expect": {
   "path_id_invariant": {
    "prefix": "/api/v1/templates/",
    "suffix": "/"
   },
   "outcome": {
    "kind": "ok_or_validation_without_request"
   }
  },
  "variants": [
   {
    "call.id": "a/b"
   },
   {
    "call.id": "../x"
   },
   {
    "call.id": ".."
   },
   {
    "call.id": "."
   },
   {
    "call.id": "a?b=c"
   },
   {
    "call.id": "a#frag"
   },
   {
    "call.id": "a b"
   },
   {
    "call.id": "%2F"
   },
   {
    "call.id": "a%2Fb"
   },
   {
    "call.id": "x/../y"
   },
   {
    "call.id": "\\\\evil"
   },
   {
    "call.id": "é/ü"
   },
   {
    "call.id": "a;b"
   },
   {
    "call.id": "?"
   },
   {
    "call.id": "#"
   }
  ]
 },
