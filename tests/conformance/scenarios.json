[
 {
  "id": "C-01a-standard-headers",
  "doc": "conventions: Behaviour/Headers",
  "client": {
   "api_key": "nova_key_abc",
   "tenant_id": "00000000-0000-0000-0000-000000000001"
  },
  "call": {
   "op": "health"
  },
  "server": [
   {
    "status": 200,
    "json": {
     "success": true,
     "message": "ok",
     "data": {
      "status": "ok"
     },
     "meta": {
      "correlation_id": "cid-1"
     }
    }
   }
  ],
  "expect": {
   "requests": [
    {
     "method": "GET",
     "path": "/api/v1/health/",
     "headers_equal": {
      "authorization": "Bearer nova_key_abc",
      "accept": "application/json",
      "x-tenant-id": "00000000-0000-0000-0000-000000000001"
     },
     "user_agent_regex": "^Nova-[A-Za-z.]+-SDK/\\d+\\.\\d+\\.\\d+"
    }
   ],
   "outcome": {
    "kind": "ok",
    "data": {
     "status": "ok"
    }
   }
  }
 },
