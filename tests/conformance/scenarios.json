    "status": 503,
    "json": {
     "success": false,
     "message": "down",
     "data": null,
     "error": {
      "code": "SERVICE_UNAVAILABLE",
      "message": "down"
     },
     "meta": {
      "correlation_id": "cid-err"
     }
    }
   },
   {
    "status": 200,
    "json": {
     "success": true,
     "message": "ok",
     "data": {
      "id": "t-1",
      "name": "Welcome"
     },
     "meta": {
      "correlation_id": "cid-1"
     }
    }
   }
  ],
  "expect": {
   "request_count": 2,
   "outcome": {
    "kind": "ok",
    "data": {
     "id": "t-1",
     "name": "Welcome"
    }
   }
  },
  "variants": [
   {
    "server.0.status": 503
   },
   {
    "server.0.status": 502
   },
   {
    "server.0.status": 504
   },
   {
    "server.0.status": 429
   }
  ]
 },
