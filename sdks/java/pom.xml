<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.infimatrix</groupId>
  <artifactId>nova-sdk</artifactId>
  <version>0.2.1</version>
  <packaging>jar</packaging>

  <name>Nova SDK for Java</name>
  <description>Official Java SDK for Nova, the dynamic email template and email delivery platform.</description>
  <url>https://github.com/infimatrix/nova-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Nova Engineering Team</name>
      <organization>Infimatrix</organization>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/infimatrix/nova-sdk.git</connection>
    <url>https://github.com/infimatrix/nova-sdk</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/infimatrix/nova-sdk/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <jackson.version>2.22.4</jackson.version>
    <junit.version>5.14.4</junit.version>
    <jqwik.version>1.10.2</jqwik.version>
    <jacoco.minimum.line>0.85</jacoco.minimum.line>
    <!-- Nothing is deployed unless the artifact-registry profile is chosen explicitly. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- The only runtime dependency. HTTP uses the JDK's java.net.http client. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Property-based tests (test scope only; never shipped). EPL-2.0. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>${jqwik.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <includes><include>LICENSE</include></includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[17,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all,-processing</arg>
            <arg>-Xlint:-options</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <systemPropertyVariables>
            <project.version>${project.version}</project.version>
            <nova.repo.root>${project.basedir}/../..</nova.repo.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.16</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <excludes><exclude>com/infimatrix/nova/models/**</exclude></excludes>
            </configuration>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <!-- Generated models are excluded: they are covered by (de)serialization tests, not line counts. -->
              <excludes><exclude>com/infimatrix/nova/models/**</exclude></excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.minimum.line}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>10.26.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <suppressionsLocation>checkstyle-suppressions.xml</suppressionsLocation>
          <propertyExpansion>checkstyle.suppressions.file=${project.basedir}/checkstyle-suppressions.xml</propertyExpansion>
          <sourceDirectories>
            <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
          </sourceDirectories>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <excludes>**/models/*.java</excludes>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <doclint>all,-missing</doclint>
          <quiet>true</quiet>
          <failOnWarnings>true</failOnWarnings>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Publish to Google Cloud Artifact Registry (Maven). Opt in with -Partifact-registry and name the target, e.g.
         mvn -B deploy -Partifact-registry -Dar.project=<PROJECT> -Dar.location=<LOCATION> -Dar.repository=<REPOSITORY>
         Credentials come from the <server id="artifact-registry"> entry of your own ~/.m2/settings.xml; none live here. -->
    <profile>
      <id>artifact-registry</id>
      <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
      </properties>
      <distributionManagement>
        <repository>
          <id>artifact-registry</id>
          <url>https://${ar.location}-maven.pkg.dev/${ar.project}/${ar.repository}</url>
        </repository>
      </distributionManagement>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>require-registry-target</id>
                <phase>validate</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>ar.project</property>
                      <message>Set -Dar.project=&lt;PROJECT&gt;</message>
                      <regex>[a-z][a-z0-9-]{4,}[a-z0-9]</regex>
                      <regexMessage>ar.project must be a Google Cloud project id</regexMessage>
                    </requireProperty>
                    <requireProperty>
                      <property>ar.location</property>
                      <message>Set -Dar.location=&lt;LOCATION&gt;</message>
                      <regex>[a-z]+(-[a-z]+[0-9]+)?</regex>
                      <regexMessage>ar.location must be a region such as europe-west1</regexMessage>
                    </requireProperty>
                    <requireProperty>
                      <property>ar.repository</property>
                      <message>Set -Dar.repository=&lt;REPOSITORY&gt;</message>
                      <regex>[a-z][a-z0-9-]*</regex>
                      <regexMessage>ar.repository must be a repository id</regexMessage>
                    </requireProperty>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Mutation testing of the handwritten transport code: mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.30.2</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.3</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.infimatrix.nova.http.*</param>
                <param>com.infimatrix.nova.NovaConfig</param>
                <param>com.infimatrix.nova.Page*</param>
                <param>com.infimatrix.nova.Query*</param>
                <param>com.infimatrix.nova.errors.*</param>
                <param>com.infimatrix.nova.resources.Validate</param>
              </targetClasses>
              <targetTests>
                <param>com.infimatrix.nova.*</param>
              </targetTests>
              <excludedTestClasses>
                <param>com.infimatrix.nova.ContractTest</param>
              </excludedTestClasses>
              <threads>4</threads>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>XML</param>
                <param>HTML</param>
              </outputFormats>
              <jvmArgs>
                <jvmArg>-Dproject.version=${project.version}</jvmArg>
                <jvmArg>-Dnova.repo.root=${project.basedir}/../..</jvmArg>
              </jvmArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
